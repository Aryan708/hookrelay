# Copy to .env and fill in. Never commit .env (it is git-ignored).
# Generate secrets with:  openssl rand -hex 32

POSTGRES_PASSWORD=
JWT_ACCESS_SECRET=
# 64 hex chars (32 bytes) - encrypts webhook signing secrets at rest
ENCRYPTION_KEY=
N8N_ENCRYPTION_KEY=

# Optional: GitHub OAuth app (callback: http://localhost:3000/api/v1/auth/github/callback)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: used by the n8n workflows
HOOKRELAY_DESTINATION_SECRET=
SLACK_WEBHOOK_URL=
