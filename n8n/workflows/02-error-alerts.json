{
  "name": "HookRelay: workflow error alerts",
  "nodes": [
    {
      "parameters": {},
      "id": "f0c760d7-af62-4d07-b148-62956c9c333e",
      "name": "On workflow error",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Runs whenever a workflow that lists this one as its Error Workflow fails.\nconst e = $input.first().json;\nconst wf = e.workflow || {};\nconst ex = e.execution || {};\nconst err = ex.error || {};\nreturn [{\n  json: {\n    text: [\n      `:rotating_light: n8n workflow failed: *${wf.name}*`,\n      `Node: ${ex.lastNodeExecuted || 'unknown'}`,\n      `Error: ${(err.message || 'no message').slice(0, 300)}`,\n      ex.url ? `Execution: ${ex.url}` : null,\n      'HookRelay will retry the delivery automatically (the webhook returned 5xx).',\n    ].filter(Boolean).join('\\n'),\n  },\n}];"
      },
      "id": "20385c9f-8f3e-493f-85ef-91657493a529",
      "name": "Format alert",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: $json.text }) }}",
        "options": {}
      },
      "id": "39422096-6a30-4b37-91d6-d0fb3bd149ce",
      "name": "Post to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "On workflow error": {
      "main": [
        [
          {
            "node": "Format alert",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format alert": {
      "main": [
        [
          {
            "node": "Post to Slack",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "active": false,
  "tags": [
    {
      "name": "hookrelay"
    },
    {
      "name": "monitoring"
    }
  ]
}
