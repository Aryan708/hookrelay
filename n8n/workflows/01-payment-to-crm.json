{
  "id": "hrPaymentToCrm01",
  "name": "HookRelay: payment to CRM, Slack and receipt email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "hookrelay-payments",
        "responseMode": "responseNode",
        "options": {
          "rawBody": true
        }
      },
      "id": "48065c91-f1a5-4a94-be3d-678bd8d5f55f",
      "name": "HookRelay webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "0659583c-3d57-4d10-8563-d4c3b2265947"
    },
    {
      "parameters": {
        "jsCode": "// Verify X-HookRelay-Signature before trusting anything in the request.\n// Signature = HMAC-SHA256(secret, `${t}.${rawBody}`), header \"t=<unix>,v1=<hex>\".\n// n8n env needs: NODE_FUNCTION_ALLOW_BUILTIN=crypto, HOOKRELAY_DESTINATION_SECRET=<destination secret>\nconst crypto = require('crypto');\nconst secret = $env.HOOKRELAY_DESTINATION_SECRET;\nconst req = $input.first().json;\nconst header = req.headers['x-hookrelay-signature'] || '';\n\n// The Webhook node keeps the exact raw bytes (Raw Body option) - sign over those, not re-serialized JSON.\nlet raw;\ntry {\n  raw = (await this.helpers.getBinaryDataBuffer(0, 'data')).toString('utf8');\n} catch {\n  raw = JSON.stringify(req.body);\n}\n\nconst parts = {};\nfor (const piece of header.split(',')) {\n  const i = piece.indexOf('=');\n  if (i > 0) parts[piece.slice(0, i).trim()] = piece.slice(i + 1).trim();\n}\nconst t = Number(parts.t);\nconst fresh = Number.isInteger(t) && Math.abs(Date.now() / 1000 - t) <= 300;\nconst expected = secret ? crypto.createHmac('sha256', secret).update(`${t}.${raw}`).digest('hex') : '';\nconst valid =\n  Boolean(secret) && fresh && typeof parts.v1 === 'string' && parts.v1.length === expected.length &&\n  crypto.timingSafeEqual(Buffer.from(parts.v1), Buffer.from(expected));\n\nreturn [{\n  json: {\n    valid,\n    reason: !secret ? 'missing_secret' : !fresh ? 'expired_or_malformed' : valid ? null : 'mismatch',\n    eventId: req.headers['x-hookrelay-event-id'],\n    deliveryId: req.headers['x-hookrelay-delivery-id'],\n    payload: typeof req.body === 'object' ? req.body : JSON.parse(raw),\n  },\n}];"
      },
      "id": "60f08dbb-9ae2-49df-be98-90edd6873c9b",
      "name": "Verify signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "0429b4d1-2ee6-4657-bd68-68f4b6d5bf1b",
              "leftValue": "={{ $json.valid }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a6181e7-56f7-4d35-97b8-de4d4b35a13e",
      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"error\": \"invalid_signature\", \"reason\": $json.reason } }}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "6760c777-3b35-45f6-883e-efdcac828880",
      "name": "Reject (401)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        660,
        480
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.hubapi.com/crm/v3/objects/contacts/batch/upsert",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ inputs: [{ idProperty: 'email', id: $('Verify signature').item.json.payload.customer.email, properties: { email: $('Verify signature').item.json.payload.customer.email, firstname: ($('Verify signature').item.json.payload.customer.name || '').split(' ')[0], lifecyclestage: 'customer', last_payment_amount: $('Verify signature').item.json.payload.amount / 100 } }] }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "9118737f-2f3f-4780-8e62-2504fd8bc434",
      "name": "Upsert CRM contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        200
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "HubSpot private app token"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "e276bd29-4820-415e-9858-e4ca37974013",
              "leftValue": "={{ $('Verify signature').item.json.payload.amount }}",
              "operator": {
                "type": "number",
                "operation": "gte"
              },
              "rightValue": 10000
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "24967543-36af-468e-9b40-ce55849f8707",
      "name": "High-value payment?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SLACK_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: ':moneybag: ' + $('Verify signature').item.json.payload.summary + ' (event ' + $('Verify signature').item.json.eventId + ')' }) }}",
        "options": {}
      },
      "id": "f4d11def-68a4-497e-927b-ed1b01591477",
      "name": "Alert sales in Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
