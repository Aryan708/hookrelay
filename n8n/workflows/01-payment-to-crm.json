        "method": "POST",
        "url": "https://api.sendgrid.com/v3/mail/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ personalizations: [{ to: [{ email: $('Verify signature').item.json.payload.customer.email }] }], from: { email: 'billing@example.com' }, subject: 'Thanks for your payment', content: [{ type: 'text/plain', value: 'Hi ' + $('Verify signature').item.json.payload.customer.name + ', we received your payment of ' + ($('Verify signature').item.json.payload.amount / 100).toFixed(2) + ' ' + String($('Verify signature').item.json.payload.currency).toUpperCase() + '.' }] }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "047ac36e-ce3f-4d02-b61d-4ea8141b2dd4",
      "name": "Send receipt email",
