# Local development (npm run dev:api). Copy to apps/api/.env and load it, e.g. `set -a; . ./.env; set +a`.
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://postgres:postgres@localhost:5432/hookrelay

# openssl rand -hex 32
JWT_ACCESS_SECRET=
# openssl rand -hex 32  (must be exactly 64 hex characters)
ENCRYPTION_KEY=

WEB_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:3000/api
CORS_ORIGINS=http://localhost:3000

# Local only: lets you deliver to http://localhost receivers. Refused when NODE_ENV=production.
ALLOW_PRIVATE_DESTINATIONS=true

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# npm run seed
SEED_PASSWORD=
